FROM benchmarks:rust

ARG version
RUN wget --progress=dot:giga -O - \
    https://cache.ruby-lang.org/pub/ruby/4.0/ruby-$version.tar.gz \
    | tar -xz \
    && cd ruby-$version \
    && ./configure --prefix=/opt/ruby \
    && make -j 6 \
    && make install \
    && cd /opt && rm -rf ruby-$version
ENV PATH=/opt/ruby/bin:$PATH
