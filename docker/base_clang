FROM langarena:base

ARG version
RUN wget https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/LLVM-$version-Linux-X64.tar.xz \
    && tar -xf /opt/LLVM-$version-Linux-X64.tar.xz -C /opt \
    && rm /opt/LLVM-$version-Linux-X64.tar.xz \
    && mv /opt/LLVM-$version-Linux-X64 /opt/llvm

ENV PATH="/opt/llvm/bin:$PATH"

RUN update-alternatives --install /usr/bin/cc cc /opt/llvm/bin/clang 100 \
    && update-alternatives --install /usr/bin/c++ c++ /opt/llvm/bin/clang++ 100 \
    && update-alternatives --install /usr/bin/gcc gcc /opt/llvm/bin/clang 100 \
    && update-alternatives --install /usr/bin/g++ g++ /opt/llvm/bin/clang++ 100 \
    && update-alternatives --install /usr/bin/clang clang /opt/llvm/bin/clang 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /opt/llvm/bin/clang++ 100 \
    && update-alternatives --install /usr/bin/ld ld /opt/llvm/bin/ld.lld 50 \
    && update-alternatives --set cc /opt/llvm/bin/clang \
    && update-alternatives --set c++ /opt/llvm/bin/clang++ \
    && update-alternatives --set gcc /opt/llvm/bin/clang \
    && update-alternatives --set g++ /opt/llvm/bin/clang++
