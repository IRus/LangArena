CC2 = gcc
MYCC = mycc

BACKEND ?= llvm
MODE ?= release
COMPILER ?= gcc

ifeq ($(MODE), release)
    MYCC_FLAGS_MODE = --release
else ifeq ($(MODE), debug)
    MYCC_FLAGS_MODE = --debug
else ifeq ($(MODE), dev)
    MYCC_FLAGS_MODE = --dev
else
    MYCC_FLAGS_MODE = --release
endif

ifeq ($(BACKEND), llvm)
    MYCC_FLAGS_BACKEND = --backend llvm
    BUILD_DIR = target/mycc-llvm-$(MODE)-$(COMPILER)
else ifeq ($(BACKEND), qbe)
    MYCC_FLAGS_BACKEND = --backend qbe
    BUILD_DIR = target/mycc-qbe-$(MODE)-$(COMPILER)
else ifeq ($(BACKEND), c)
    MYCC_FLAGS_BACKEND = --backend c
    BUILD_DIR = target/mycc-c-$(MODE)-$(COMPILER)
else
    MYCC_FLAGS_BACKEND = --backend llvm
    BUILD_DIR = target/mycc-llvm-$(MODE)-$(COMPILER)
endif

DEPS_DIR = target/deps/mycc-$(BACKEND)-$(MODE)-$(COMPILER)

ARCH = $(shell uname -m)
UNAME_S = $(shell uname -s)

MYCC_INCLUDE ?= ./src,deps/base64/include,deps/yyjson/src
MYCC_LIBRARY ?= /usr/lib,/usr/local/lib,/opt/llvm/lib

LIBS = -lpcre2-8 -lm -lpthread

CFLAGS2 = -O2 -DNDEBUG
LDFLAGS2 = -lm -pthread -lpcre2-8

SRC_DIR = src
SRCS = $(wildcard $(SRC_DIR)/*.c)
MAIN_SRC = main.c

OBJS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(SRCS))
MAIN_OBJ = $(BUILD_DIR)/main.o

DEPS_OBJS = $(DEPS_DIR)/libbase64.o $(DEPS_DIR)/yyjson.o

PROJECT_NAME ?= benchmark
TARGET = $(BUILD_DIR)/$(PROJECT_NAME)

all: $(TARGET)

deps/base64:
	git clone https://github.com/aklomp/base64.git $@

deps/yyjson:
	git clone https://github.com/ibireme/yyjson.git $@

deps: deps/base64 deps/yyjson

$(BUILD_DIR) $(BUILD_DIR)/$(SRC_DIR) $(DEPS_DIR):
	mkdir -p $@

$(DEPS_DIR)/libbase64.o: deps/base64 | $(DEPS_DIR)
	cd deps/base64 && \
	if [ "$(ARCH)" = "x86_64" ]; then \
		AVX2_CFLAGS=-mavx2 SSSE3_CFLAGS=-mssse3 SSE41_CFLAGS=-msse4.1 SSE42_CFLAGS=-msse4.2 AVX_CFLAGS=-mavx \
		CC="$(CC2)" CFLAGS="$(CFLAGS2)" make -i lib/libbase64.o; \
	elif [ "$(ARCH)" = "arm64" ] || [ "$(ARCH)" = "aarch64" ]; then \
		CC="$(CC2)" CFLAGS="-arch arm64 $(CFLAGS2)" NEON64_CFLAGS=" " make -i lib/libbase64.o; \
	else \
		CC="$(CC2)" CFLAGS="$(CFLAGS2)" make -i lib/libbase64.o; \
	fi && \
	cd - && \
	cp deps/base64/lib/libbase64.o $@

$(DEPS_DIR)/yyjson.o: deps/yyjson | $(DEPS_DIR)
	cd deps/yyjson/src && $(CC2) $(CFLAGS2) -c yyjson.c && cd -
	cp deps/yyjson/src/yyjson.o $@

$(BUILD_DIR)/main.o: $(MAIN_SRC) | $(BUILD_DIR) deps
	export MYCC_INCLUDE="$(MYCC_INCLUDE)" && export CC="$(COMPILER)" && $(MYCC) o $(MYCC_FLAGS_MODE) $(MYCC_FLAGS_BACKEND) $(MAIN_SRC) $@

$(BUILD_DIR)/$(SRC_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)/$(SRC_DIR) deps
	export MYCC_INCLUDE="$(MYCC_INCLUDE)" && export CC="$(COMPILER)" && $(MYCC) o $(MYCC_FLAGS_MODE) $(MYCC_FLAGS_BACKEND) $< $@

$(TARGET): $(OBJS) $(MAIN_OBJ) $(DEPS_OBJS)
	$(CC2) $^ -o $@ $(LDFLAGS2) $(LIBS)

clean:
	rm -rf target/

distclean: clean
	rm -rf deps

info:
	@echo "MYCC:           $(MYCC)"
	@echo "CC2:            $(CC2)"
	@echo "MODE:           $(MODE)"
	@echo "BACKEND:        $(BACKEND)"
	@echo "COMPILER:       $(COMPILER)"
	@echo "BUILD_DIR:      $(BUILD_DIR)"
	@echo "DEPS_DIR:       $(DEPS_DIR)"
	@echo "TARGET:         $(TARGET)"
	@echo "PROJECT_NAME:   $(PROJECT_NAME)"
	@echo "MYCC_INCLUDE:   $(MYCC_INCLUDE)"
	@echo "MYCC_LIBRARY:   $(MYCC_LIBRARY)"
	@echo "CFLAGS2:        $(CFLAGS2)"
	@echo "LDFLAGS2:       $(LDFLAGS2)"
	@echo "LIBS:           $(LIBS)"

help:
	@echo "Usage: make -f Makefile_mycc [target] [BACKEND=<backend>] [MODE=<mode>] [COMPILER=<compiler>]"
	@echo ""
	@echo "Backends: llvm, qbe, c (default: llvm)"
	@echo "Modes: release, debug, dev (default: release)"
	@echo "Compiler: gcc, clang, etc (default: gcc)"
	@echo ""
	@echo "Targets:"
	@echo "  all       - Build project"
	@echo "  clean     - Remove all built files"
	@echo "  distclean - Remove everything including deps sources"
	@echo "  info      - Show build configuration"
	@echo "  help      - Show this help"
	@echo ""
	@echo "Examples:"
	@echo "  make -f Makefile_mycc"
	@echo "  make -f Makefile_mycc BACKEND=qbe MODE=debug"
	@echo "  make -f Makefile_mycc BACKEND=c COMPILER=clang"
	@echo "  make -f Makefile_mycc PROJECT_NAME=benchmark"

.PHONY: all deps clean distclean info help
