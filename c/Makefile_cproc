CC = cproc -c
CC2 = gcc

CFLAGS_BASE = -I./src -Ideps/base64/include -Ideps/yyjson/src -pthread

CFLAGS = $(CFLAGS_BASE) -DNDEBUG

CFLAGS2 = -O2 -DNDEBUG
LDFLAGS2 = -lm -pthread -lpcre2-8

BUILD_DIR = target/cproc
DEPS_DIR = target/deps/cproc

ARCH = $(shell uname -m)

SRC_DIR = src
SRCS = $(wildcard $(SRC_DIR)/*.c)

MAIN_OBJ = $(BUILD_DIR)/main.o
OBJS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(SRCS))

DEPS_OBJS = $(DEPS_DIR)/libbase64.o $(DEPS_DIR)/yyjson.o

TARGET = $(BUILD_DIR)/benchmark

all: $(TARGET)

deps/base64:
	@echo "Cloning base64..."
	git clone https://github.com/aklomp/base64.git $@

deps/yyjson:
	@echo "Cloning yyjson..."
	git clone https://github.com/ibireme/yyjson.git $@
	@echo "Patching yyjson.h for cproc..."
	@sed -i '/^#\s*error\s*non\s*8-bit\s*char\s*is\s*not\s*supported/d' $@/src/yyjson.h

deps: deps/base64 deps/yyjson

$(BUILD_DIR) $(BUILD_DIR)/$(SRC_DIR) $(DEPS_DIR):
	mkdir -p $@

$(DEPS_DIR)/libbase64.o: deps/base64 | $(DEPS_DIR)
	@echo "Building base64 with GCC..."
	cd deps/base64 && \
	if [ "$(ARCH)" = "x86_64" ]; then \
		AVX2_CFLAGS=-mavx2 SSSE3_CFLAGS=-mssse3 SSE41_CFLAGS=-msse4.1 SSE42_CFLAGS=-msse4.2 AVX_CFLAGS=-mavx \
		CC="$(CC2)" CFLAGS="$(CFLAGS2)" make -i lib/libbase64.o; \
	elif [ "$(ARCH)" = "arm64" ] || [ "$(ARCH)" = "aarch64" ]; then \
		CC="$(CC2)" CFLAGS="-arch arm64 $(CFLAGS2)" NEON64_CFLAGS=" " make -i lib/libbase64.o; \
	else \
		CC="$(CC2)" CFLAGS="$(CFLAGS2)" make -i lib/libbase64.o; \
	fi && \
	cd - && \
	cp deps/base64/lib/libbase64.o $@

$(DEPS_DIR)/yyjson.o: deps/yyjson | $(DEPS_DIR)
	@echo "Building yyjson with GCC..."
	cd deps/yyjson/src && $(CC2) $(CFLAGS2) -c yyjson.c && cd -
	cp deps/yyjson/src/yyjson.o $@

$(BUILD_DIR)/main.o: main.c | $(BUILD_DIR) deps
	@echo "Compiling main.c with cproc..."
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/$(SRC_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)/$(SRC_DIR) deps
	@echo "Compiling $< with cproc..."
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): $(OBJS) $(MAIN_OBJ) $(DEPS_OBJS)
	@echo "Linking with GCC..."
	$(CC2) $^ -o $@ $(LDFLAGS2)

clean:
	@echo "Cleaning..."
	rm -rf $(BUILD_DIR) $(DEPS_DIR)
	@cd deps/base64 && make clean 2>/dev/null || true

distclean: clean
	@echo "Removing dependencies..."
	rm -rf deps

info:
	@echo "Project compiler: cproc -c"
	@echo "Deps compiler:    gcc"
	@echo "Build dir:        $(BUILD_DIR)"
	@echo "Deps dir:         $(DEPS_DIR)"
	@echo "Target:           $(TARGET)"
	@echo "CFLAGS:           $(CFLAGS)"
	@echo "CFLAGS2:          $(CFLAGS2)"

help:
	@echo "Usage: make -f Makefile2 [target]"
	@echo ""
	@echo "Targets:"
	@echo "  all           - build project (default)"
	@echo "  clean         - remove built files"
	@echo "  distclean     - remove everything including deps"
	@echo "  info          - show build configuration"
	@echo "  help          - show this help"

.PHONY: all deps clean distclean info help